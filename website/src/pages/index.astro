---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";

const setupSnippet = `import { breadcrumb } from "@breadcrumb-sh/core";
import { postgres } from "@breadcrumb-sh/core/adapters";

export const bc = breadcrumb({
  database: postgres(process.env.DATABASE_URL!),
  basePath: "/admin/traces",
  authorize: (req) => isAdmin(req),
});

// Trace the Vercel AI SDK — spans nest automatically.
const { text } = await generateText({
  model: openai("gpt-5"),
  prompt,
  experimental_telemetry: bc.telemetry({ functionId: "reply" }),
});`;

const clientSnippet = `import { useSessions, useStats } from "@breadcrumb-sh/react";

function Dashboard() {
  const { data: stats } = useStats({ status: "error" });
  const { data } = useSessions({ environment: "production" });
  // …render it however your product looks.
}`;

const features = [
	{
		icon: "ph-database",
		title: "Your database",
		body: "Traces land in your own Postgres through additive-only migrations. Query them with the SQL and connection you already have.",
	},
	{
		icon: "ph-layout",
		title: "Your UI",
		body: "Serve the built-in dashboard from your app, or build your own with the typed client, React hooks, and headless kit.",
	},
	{
		icon: "ph-plugs-connected",
		title: "Drop-in tracing",
		body: "One config object. Works with the Vercel AI SDK's telemetry, OpenTelemetry ingest, or a manual trace() API.",
	},
];
---

<Layout>
	<div class="relative w-full">
		<!-- Header -->
		<header class="sticky top-0 z-20 bg-bg/80 backdrop-blur-md">
			<div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6">
				<a href="/" class="flex items-center gap-2 text-fg">
					<Logo class="h-[22px] w-[22px]" />
					<span class="text-lg font-medium tracking-tight">breadcrumb</span>
				</a>
				<nav class="flex items-center gap-6 text-sm text-fg-muted">
					<a href="/docs/" class="hover:text-fg transition-colors">Docs</a>
					<a
						href="https://github.com/breadcrumb-sh/breadcrumb"
						target="_blank"
						rel="noreferrer"
						class="flex items-center gap-1.5 hover:text-fg transition-colors"
					>
						<i class="ph ph-github-logo"></i>
						GitHub
					</a>
				</nav>
			</div>
		</header>

		<!-- Hero -->
		<section class="mx-auto max-w-3xl px-6 pt-24 md:pt-32 pb-8 flex flex-col items-center gap-7 text-center">
			<span class="font-mono text-xs uppercase tracking-[0.18em] text-accent-muted">Embeddable LLM tracing</span>
			<h1 class="text-[40px] md:text-[58px] font-medium leading-[1.05] tracking-[-1.5px] text-balance text-fg">
				LLM tracing you own,<br class="hidden md:block" /> end to end.
			</h1>
			<p class="max-w-xl text-fg-muted md:text-lg leading-7 text-balance">
				Breadcrumb drops into your backend, stores traces in your own Postgres, and serves a dashboard from your app.
				No external platform, no data leaving your stack.
			</p>

			<div class="mt-1 flex w-full max-w-md flex-col items-center gap-4">
				<button
					id="install"
					type="button"
					data-cmd="npm i @breadcrumb-sh/core"
					class="group flex h-11 w-full items-center justify-center gap-3 rounded-sm ring-[1px] ring-border bg-bg font-mono text-sm text-fg-muted hover:text-fg hover:ring-border-strong transition-colors cursor-pointer"
				>
					<span class="text-fg-faint">$</span>
					<code>npm i @breadcrumb-sh/core</code>
					<i id="install-icon" class="ph ph-copy text-fg-faint group-hover:text-fg-muted"></i>
				</button>
				<div class="flex w-full flex-col sm:flex-row gap-3">
					<a
						href="/docs/"
						class="h-11 flex-1 flex items-center justify-center rounded-sm bg-fg text-bg text-sm font-medium hover:-translate-y-0.5 transition-transform"
					>
						Read the docs
					</a>
					<a
						href="https://github.com/breadcrumb-sh/breadcrumb"
						target="_blank"
						rel="noreferrer"
						class="h-11 flex-1 flex items-center justify-center gap-1.5 rounded-sm ring-[1px] ring-fg-faint bg-bg text-sm text-fg-muted hover:text-fg hover:ring-fg-muted hover:-translate-y-0.5 transition-all"
					>
						<i class="ph ph-star"></i>
						Star on GitHub
					</a>
				</div>
			</div>
		</section>

		<!-- Setup snippet -->
		<section class="mx-auto max-w-2xl px-6 pt-8 pb-24">
			<div class="overflow-hidden rounded-lg ring-[1px] ring-border">
				<div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
					<span class="h-2.5 w-2.5 rounded-full bg-surface"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-surface"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-surface"></span>
					<span class="ml-2 font-mono text-xs text-fg-faint">lib/breadcrumb.ts</span>
				</div>
				<Code code={setupSnippet} lang="ts" theme="tokyo-night" />
			</div>
		</section>

		<!-- Features -->
		<section class="mx-auto max-w-5xl px-6 pb-24">
			<div class="grid gap-px overflow-hidden rounded-lg ring-[1px] ring-border bg-border md:grid-cols-3">
				{
					features.map((f) => (
						<div class="flex flex-col gap-3 bg-bg p-7">
							<i class={`ph ${f.icon} text-xl text-accent`} />
							<h3 class="text-fg font-medium">{f.title}</h3>
							<p class="text-sm leading-6 text-fg-muted">{f.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- Own your UI -->
		<section class="mx-auto max-w-5xl px-6 pb-28">
			<div class="grid items-center gap-10 md:grid-cols-2">
				<div class="flex flex-col gap-4">
					<h2 class="text-2xl md:text-3xl font-medium tracking-[-0.5px] text-fg text-balance">
						The admin panel is yours to build.
					</h2>
					<p class="text-fg-muted leading-7">
						Your traces sit in your database, so the dashboard can look like your product. Query the server SDK from a
						React Server Component, wire up the typed client in a SPA, or drop in the React hooks — all against the same
						typed contract, with a headless kit for the span-tree logic.
					</p>
					<a href="/docs/react/" class="w-fit text-sm text-fg underline decoration-border-strong underline-offset-4 hover:decoration-fg-muted">
						Building a custom UI →
					</a>
				</div>
				<div class="overflow-hidden rounded-lg ring-[1px] ring-border">
					<Code code={clientSnippet} lang="ts" theme="tokyo-night" />
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="mx-auto max-w-3xl px-6 pb-28 flex flex-col items-center gap-6 text-center">
			<h2 class="text-3xl md:text-4xl font-medium tracking-[-0.5px] text-balance text-fg">
				Trace your AI app in your own stack.
			</h2>
			<p class="max-w-md text-fg-muted leading-7 text-balance">
				Open source, self-hosted, and up in minutes. Bring your own Postgres.
			</p>
			<a
				href="/docs/quickstart/"
				class="h-11 w-52 flex items-center justify-center rounded-sm bg-fg text-bg text-sm font-medium hover:-translate-y-0.5 transition-transform"
			>
				Quickstart
			</a>
		</section>

		<footer class="border-t border-border">
			<div class="mx-auto flex max-w-5xl flex-col-reverse gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-xs text-fg-faint">© 2026 Breadcrumb. MIT licensed.</p>
				<div class="flex items-center gap-6 text-xs text-fg-muted">
					<a href="/docs/" class="hover:text-fg transition-colors">Docs</a>
					<a href="https://github.com/breadcrumb-sh/breadcrumb" target="_blank" rel="noreferrer" class="hover:text-fg transition-colors">GitHub</a>
				</div>
			</div>
		</footer>
	</div>
</Layout>

<script>
	const btn = document.getElementById("install");
	const icon = document.getElementById("install-icon");
	btn?.addEventListener("click", async () => {
		try {
			await navigator.clipboard.writeText(btn.dataset.cmd ?? "");
			icon?.classList.replace("ph-copy", "ph-check");
			setTimeout(() => icon?.classList.replace("ph-check", "ph-copy"), 1500);
		} catch {}
	});
</script>
